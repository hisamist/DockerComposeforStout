# =============================================================================
#  Variables de la stack. ./setup.sh crée .env à partir de ce modèle et
#  remplace chaque "change_me" par un mot de passe aléatoire, puis ajoute
#  les secrets internes de Stoat (STOAT_VAPID_*, STOAT_FILES_ENCRYPTION_KEY,
#  LIVEKIT_SECRET). Sauvegarder .env : sans STOAT_FILES_ENCRYPTION_KEY,
#  les fichiers déjà envoyés deviennent illisibles.
# =============================================================================

# --- Instance (réglées par ./setup.sh <url-publique>) ---
STOAT_PUBLIC_URL=http://stoat.localhost
STOAT_PUBLIC_WS=ws://stoat.localhost
STOAT_DOMAIN=stoat.localhost
# Versions des sources compilées (tags de stoatchat/stoatchat et stoatchat/for-web)
STOAT_VERSION=v0.15.5
STOAT_WEB_VERSION=v0.15.3

# --- MongoDB ---
# Compte administrateur (utilisé uniquement à l'initialisation et par mongo-express)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me
# Compte applicatif de Stoat (droits limités à la base "revolt")
MONGO_APP_USER=stoat
MONGO_APP_PASSWORD=change_me

# --- RabbitMQ ---
RABBIT_USER=stoat
RABBIT_PASSWORD=change_me

# --- MinIO (stockage des fichiers) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
# Compte de service d'Autumn (politique readwrite, pas admin)
MINIO_APP_USER=autumn
MINIO_APP_PASSWORD=change_me

# --- Supervision (profil "monitoring") : compte "admin" de Grafana ---
GRAFANA_ADMIN_PASSWORD=change_me

# --- Bridge Discord <-> Stoat ---
# Les tokens du bridge ne sont PAS ici : ce sont des secrets Docker, dans ./secrets/
#   secrets/discord_token.txt   Developer Portal > Bot > Reset Token
#                               (activer "Message Content Intent" et "Server Members Intent")
#   secrets/stoat_token.txt     http://stoat.localhost > Paramètres > Mes bots
#   secrets/bridge_api_key.txt  généré par setup.sh
