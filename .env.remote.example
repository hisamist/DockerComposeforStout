# =============================================================================
#  Mode backend distant (docker-compose.remote.yaml). Copier en .env.remote.
#  S'ajoute à .env (--env-file .env --env-file .env.remote) : seules ces
#  variables changent.
#  URLs COMPLÈTES, avec http:// ou ws:// (sinon le client ne les reconnaît pas).
# =============================================================================

# Backend Stoat de l'autre PC (adresse WireGuard). Vérifier ce que le backend annonce :
#   curl http://10.8.0.1:14702/   (champs ws, features.autumn.url, features.livekit...)
STOAT_REMOTE_API_URL=http://10.8.0.1:14702
STOAT_REMOTE_WS_URL=ws://10.8.0.1:14703
STOAT_REMOTE_AUTUMN_URL=http://10.8.0.1:14704
STOAT_REMOTE_GIFBOX_URL=

# Port local du client web en mode distant (le mode normal garde le port 80)
REMOTE_HTTP_PORT=8080
REMOTE_WEB_HOST=localhost:8080
