{
  "uid": "projetbridge-cgroups",
  "title": "projetBridge — ressources vs limites cgroup",
  "description": "Consommation réelle de chaque service (cAdvisor) comparée aux limites deploy.resources.limits de la stack Compose.",
  "tags": ["projetbridge", "cgroups", "docker"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service (détail)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_memory_working_set_bytes{container_label_com_docker_compose_project=\"projetbridge\"}, container_label_com_docker_compose_service)",
        "refresh": 2,
        "sort": 1,
        "current": { "text": "api", "value": "api" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Conteneurs actifs",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(count by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"projetbridge\"}))" }],
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } }
    },
    {
      "id": 2, "type": "stat", "title": "Mémoire totale utilisée",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(container_memory_working_set_bytes{container_label_com_docker_compose_project=\"projetbridge\"})" }],
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "#2a78d6" } } }
    },
    {
      "id": 3, "type": "stat", "title": "CPU total (cœurs)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"projetbridge\"}[1m]))" }],
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#2a78d6" } } }
    },
    {
      "id": 4, "type": "stat", "title": "API Stoat — requêtes/s",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(rocket_http_requests_total[1m])) or vector(0)" }],
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#2a78d6" } } }
    },
    {
      "id": 5, "type": "bargauge", "title": "Mémoire utilisée / limite cgroup (%)",
      "description": "container_memory_working_set_bytes ÷ container_spec_memory_limit_bytes. Seuils : 70 % attention, 90 % critique (le noyau tue le processus à 100 %).",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": true, "legendFormat": "{{container_label_com_docker_compose_service}}",
        "expr": "sort_desc(100 * max by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"projetbridge\"}) / max by (container_label_com_docker_compose_service) (container_spec_memory_limit_bytes{container_label_com_docker_compose_project=\"projetbridge\"} > 0))"
      }],
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "text", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": {
        "unit": "percent", "min": 0, "max": 100, "decimals": 0,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "#2e9e5b", "value": null }, { "color": "#e8a33d", "value": 70 }, { "color": "#d64545", "value": 90 }
        ] }
      } }
    },
    {
      "id": 6, "type": "bargauge", "title": "CPU utilisé / quota cgroup (%)",
      "description": "rate(container_cpu_usage_seconds_total) ÷ (cpu_quota ÷ cpu_period). Au-delà de 100 %, le noyau ralentit le conteneur (throttling).",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": true, "legendFormat": "{{container_label_com_docker_compose_service}}",
        "expr": "sort_desc(100 * sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"projetbridge\"}[1m])) / max by (container_label_com_docker_compose_service) (container_spec_cpu_quota{container_label_com_docker_compose_project=\"projetbridge\"} / container_spec_cpu_period{container_label_com_docker_compose_project=\"projetbridge\"}))"
      }],
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "text", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": {
        "unit": "percent", "min": 0, "max": 100, "decimals": 1,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "#2e9e5b", "value": null }, { "color": "#e8a33d", "value": 70 }, { "color": "#d64545", "value": 90 }
        ] }
      } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Mémoire de « $service » : utilisée et limite",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "utilisée", "expr": "max(container_memory_working_set_bytes{container_label_com_docker_compose_project=\"projetbridge\", container_label_com_docker_compose_service=\"$service\"})" },
        { "refId": "B", "legendFormat": "limite cgroup", "expr": "max(container_spec_memory_limit_bytes{container_label_com_docker_compose_project=\"projetbridge\", container_label_com_docker_compose_service=\"$service\"} > 0)" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "utilisée" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }] },
          { "matcher": { "id": "byName", "options": "limite cgroup" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8a8f98" } },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }
          ] }
        ]
      }
    },
    {
      "id": 8, "type": "bargauge", "title": "Processus par conteneur",
      "description": "Comparés à la limite deploy.resources.limits.pids (64 à 512 selon le service).",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A", "instant": true, "legendFormat": "{{container_label_com_docker_compose_service}}",
        "expr": "sort_desc(max by (container_label_com_docker_compose_service) (container_processes{container_label_com_docker_compose_project=\"projetbridge\"}))"
      }],
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": false, "valueMode": "text", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "#2a78d6" } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "API Stoat — requêtes HTTP par code de statut",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(rocket_http_requests_total[1m]))" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } }
    }
  ]
}
